<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>华文切水果大对决</title>
    <!-- 引入 React, Babel 和 Tailwind -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Google Fonts 快乐体 -->
    <link href="https://fonts.googleapis.com/css2?family=ZCOOL+KuaiLe&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'ZCOOL KuaiLe', cursive;
            margin: 0;
            overflow: hidden;
            background: #fbbf24;
        }

        /* 动画定义 */
        @keyframes float-bg {
            0%, 100% { transform: translate(0, 0) rotate(0); }
            50% { transform: translate(30px, -40px) rotate(10deg); }
        }
        .animate-float { animation: float-bg 15s infinite ease-in-out; }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-20px); }
            75% { transform: translateX(20px); }
        }
        .animate-shake { animation: shake 0.3s ease-in-out 2; }

        @keyframes splash-anim {
            0% { transform: scale(0); opacity: 1; }
            100% { transform: scale(6); opacity: 0; }
        }
        .animate-splash { animation: splash-anim 0.6s forwards cubic-bezier(0,1,0,1); }

        @keyframes float-large {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            20% { transform: translate(70px, 45px) rotate(15deg); }
            40% { transform: translate(-60px, 90px) rotate(-10deg); }
            60% { transform: translate(-90px, -35px) rotate(12deg); }
            80% { transform: translate(45px, -70px) rotate(-18deg); }
        }
        .fruit-anim { animation: float-large 7s infinite ease-in-out; }

        input::placeholder { color: rgba(255,255,255,0.5); }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, useMemo } = React;

        // --- 题库数据 ---
        const RAW_QUESTIONS = [
            { target: '睛', distractors: ['晴'], prompt: '眼 __' },
            { target: '耍', distractors: ['要'], prompt: '玩 __' },
            { target: '洋', distractors: ['羊'], prompt: '海 __' },
            { target: '球', distractors: ['求'], prompt: '足 __' },
            { target: '处', distractors: ['外'], prompt: '到 __' },
            { target: '材', distractors: ['村'], prompt: '木 __' },
            { target: '右', distractors: ['石'], prompt: '左 __' },
            { target: '较', distractors: ['校'], prompt: '比 __' },
            { target: '浇', distractors: ['烧'], prompt: '__ 水' },
            { target: '舌', distractors: ['古'], prompt: '__ 头' },
            { target: '渔', distractors: ['鱼'], prompt: '__ 民' },
            { target: '栽', distractors: ['载'], prompt: '__ 种' },
            { target: '布', distractors: ['希'], prompt: '帆 __' },
            { target: '学', distractors: ['料'], prompt: '科 __' },
            { target: '低', distractors: ['底'], prompt: '高 __' },
            { target: '鱼', distractors: ['钩'], prompt: '钓 __' },
            { target: '草', distractors: ['清'], prompt: '青 __' },
            { target: '片', distractors: ['只', '颗'], prompt: '一 __ 面包' },
            { target: '轮', distractors: ['幅', '张'], prompt: '一 __ 明月' },
            { target: '辆', distractors: ['只', '颗'], prompt: '一 __ 汽车' },
            { target: '缸', distractors: ['张', '只'], prompt: '一 __ 水' },
            { target: '串', distractors: ['轮', '辆'], prompt: '一 __ 葡萄' },
            { target: '颗', distractors: ['片', '张'], prompt: '一 __ 星星' },
            { target: '幅', distractors: ['张', '颗'], prompt: '一 __ 图画' },
        ];

        // --- 音效组件 ---
        const playSound = (type) => {
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain); gain.connect(audioCtx.destination);
            const now = audioCtx.currentTime;
            if (type === 'correct') {
                osc.type = 'triangle'; osc.frequency.setValueAtTime(523, now); osc.frequency.exponentialRampToValueAtTime(1046, now + 0.1);
                gain.gain.setValueAtTime(0.1, now); gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
            } else if (type === 'wrong') {
                osc.type = 'sawtooth'; osc.frequency.setValueAtTime(110, now); osc.frequency.linearRampToValueAtTime(55, now + 0.3);
                gain.gain.setValueAtTime(0.1, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.3);
            } else if (type === 'quiet') {
                osc.type = 'sine'; osc.frequency.setValueAtTime(880, now); osc.frequency.linearRampToValueAtTime(440, now + 0.5);
                gain.gain.setValueAtTime(0.1, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.5);
            } else if (type === 'drum') {
                osc.type = 'sine'; osc.frequency.setValueAtTime(150, now); osc.frequency.exponentialRampToValueAtTime(40, now + 0.1);
                gain.gain.setValueAtTime(0.2, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.1);
            }
            osc.start(); osc.stop(now + 0.5);
        };

        const App = () => {
            const [gameState, setGameState] = useState('setup'); 
            const [classNameLeft, setClassNameLeft] = useState('2J');
            const [classNameRight, setClassNameRight] = useState('2F');
            const [absentLeft, setAbsentLeft] = useState([]);
            const [absentRight, setAbsentRight] = useState([]);
            const [poolLeft, setPoolLeft] = useState([]);
            const [poolRight, setPoolRight] = useState([]);
            const [questionPool, setQuestionPool] = useState([]);
            const [selectedLeft, setSelectedLeft] = useState(null);
            const [selectedRight, setSelectedRight] = useState(null);
            const [scores, setScores] = useState({ left: 0, right: 0 });
            const [behaviorScores, setBehaviorScores] = useState({ left: 0, right: 0 });
            const [currentQuestion, setCurrentQuestion] = useState(null);
            const [roundWinner, setRoundWinner] = useState(null);
            const [timeLeft, setTimeLeft] = useState(60);
            const [locks, setLocks] = useState({ left: false, right: false });
            const [failed, setFailed] = useState({ left: false, right: false });
            const [shake, setShake] = useState({ left: false, right: false });
            const [splashes, setSplashes] = useState([]);
            const [roundCount, setRoundCount] = useState(0);

            const timerRef = useRef(null);
            const studentList = useMemo(() => Array.from({ length: 35 }, (_, i) => i + 1), []);

            const initGame = () => {
                setPoolLeft(studentList.filter(n => !absentLeft.includes(n)));
                setPoolRight(studentList.filter(n => !absentRight.includes(n)));
                setQuestionPool([...RAW_QUESTIONS].sort(() => Math.random() - 0.5));
                setScores({ left: 0, right: 0 });
                setBehaviorScores({ left: 0, right: 0 });
                setRoundCount(0);
                startRoundDrawing(studentList.filter(n => !absentLeft.includes(n)), studentList.filter(n => !absentRight.includes(n)));
            };

            const startRoundDrawing = (pLeft, pRight) => {
                const curL = pLeft || poolLeft;
                const curR = pRight || poolRight;
                if (curL.length === 0 || curR.length === 0) {
                    setGameState('final_result');
                    return;
                }
                setGameState('drawing');
                let count = 0;
                const timer = setInterval(() => {
                    setSelectedLeft(curL[Math.floor(Math.random() * curL.length)]);
                    setSelectedRight(curR[Math.floor(Math.random() * curR.length)]);
                    playSound('drum');
                    if (++count > 15) {
                        clearInterval(timer);
                        const finalL = curL[Math.floor(Math.random() * curL.length)];
                        const finalR = curR[Math.floor(Math.random() * curR.length)];
                        setSelectedLeft(finalL); setSelectedRight(finalR);
                        setPoolLeft(p => p.filter(x => x !== finalL));
                        setPoolRight(p => p.filter(x => x !== finalR));
                        setTimeout(() => setGameState('ready'), 800);
                    }
                }, 100);
            };

            const startMatch = () => {
                let pool = [...questionPool];
                if (pool.length === 0) pool = [...RAW_QUESTIONS].sort(() => Math.random() - 0.5);
                const q = pool.pop();
                setQuestionPool(pool);
                setCurrentQuestion(q);
                setTimeLeft(60);
                setLocks({ left: false, right: false });
                setFailed({ left: false, right: false });
                setRoundWinner(null);
                setRoundCount(r => r + 1);
                setGameState('playing');
            };

            useEffect(() => {
                if (gameState === 'playing' && timeLeft > 0) {
                    timerRef.current = setInterval(() => {
                        setTimeLeft(t => {
                            if (t <= 1) {
                                clearInterval(timerRef.current);
                                setRoundWinner('时间到（平手）');
                                setGameState('round_result');
                                return 0;
                            }
                            return t - 1;
                        });
                    }, 1000);
                }
                return () => clearInterval(timerRef.current);
            }, [gameState, timeLeft]);

            const handleSlice = (side, isCorrect) => {
                if (locks[side] || gameState !== 'playing') return;
                if (isCorrect) {
                    playSound('correct');
                    const bonus = Math.max(5, Math.ceil(timeLeft / 2));
                    setScores(s => ({ ...s, [side]: s[side] + 10 + bonus }));
                    setRoundWinner(side === 'left' ? `${classNameLeft} 班` : `${classNameRight} 班`);
                    const id = Date.now();
                    setSplashes(p => [...p, { id, side, x: Math.random() * 60 + 20, y: Math.random() * 60 + 20 }]);
                    setTimeout(() => setSplashes(p => p.filter(s => s.id !== id)), 800);
                    setLocks({ left: true, right: true });
                    setTimeout(() => setGameState('round_result'), 1000);
                } else {
                    playSound('wrong');
                    setShake(p => ({ ...p, [side]: true }));
                    setLocks(p => ({ ...p, [side]: true }));
                    setFailed(f => {
                        const next = { ...f, [side]: true };
                        if (next.left && next.right) {
                            setTimeout(() => { setRoundWinner('没有人答对'); setGameState('round_result'); }, 1000);
                        }
                        return next;
                    });
                    setTimeout(() => setShake(p => ({ ...p, [side]: false })), 500);
                }
            };

            // --- 渲染组件 ---
            if (gameState === 'setup') {
                return (
                    <div className="min-h-screen p-8 flex flex-col items-center justify-center relative bg-gradient-to-br from-yellow-300 to-orange-400">
                        <div className="absolute inset-0 opacity-10 pointer-events-none">
                            <div className="absolute top-10 left-10 animate-float">🍉</div>
                            <div className="absolute top-40 right-20 animate-float" style={{animationDelay:'2s'}}>🍍</div>
                        </div>
                        <h1 className="text-7xl font-black text-white drop-shadow-2xl mb-8 tracking-widest">🍉 华文大对决 🍍</h1>
                        <div className="grid grid-cols-2 gap-8 w-full max-w-7xl z-10">
                            {[ {name:classNameLeft, setName:setClassNameLeft, bg:'bg-blue-500', abs:absentLeft, setAbs:setAbsentLeft, label:'左侧班级'},
                               {name:classNameRight, setName:setClassNameRight, bg:'bg-green-500', abs:absentRight, setAbs:setAbsentRight, label:'右侧班级'} ].map((cfg, idx) => (
                                <div key={idx} className="bg-white/50 backdrop-blur-md p-8 rounded-[3rem] border-8 border-white shadow-2xl">
                                    <div className={`flex items-center gap-3 ${cfg.bg} rounded-2xl px-4 py-2 border-4 border-white shadow-lg mb-4`}>
                                        <input value={cfg.name} onChange={e => cfg.setName(e.target.value)} className="bg-transparent text-white text-4xl font-black outline-none w-full" placeholder={cfg.label} />
                                    </div>
                                    <div className="grid grid-cols-7 gap-2">
                                        {studentList.map(num => (
                                            <button key={num} onClick={() => cfg.setAbs(p => p.includes(num) ? p.filter(n=>n!==num) : [...p, num])}
                                                className={`aspect-square flex items-center justify-center rounded-full text-2xl font-black transition-all ${cfg.abs.includes(num) ? 'bg-slate-400 opacity-30 scale-90' : `${cfg.bg} text-white shadow-lg hover:scale-110`}`}>
                                                {num}
                                            </button>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                        <button onClick={initGame} className="mt-10 bg-white text-orange-500 px-20 py-6 rounded-full text-5xl font-black shadow-[0_12px_0_#ea580c] hover:translate-y-2 transition-all">开始游戏</button>
                    </div>
                );
            }

            if (gameState === 'drawing' || gameState === 'ready') {
                return (
                    <div className="min-h-screen bg-sky-400 flex flex-col items-center justify-center text-white relative">
                        <h2 className="text-6xl mb-16 font-black tracking-widest text-yellow-300">第 {roundCount + 1} 组 抽签中...</h2>
                        <div className="flex gap-16 items-center z-10">
                            {[ {name:classNameLeft, num:selectedLeft, bg:'bg-blue-600', color:'text-blue-600'},
                               {name:classNameRight, num:selectedRight, bg:'bg-green-600', color:'text-green-600'} ].map((p, i) => (
                                <div key={i} className="text-center">
                                    <div className={`text-4xl mb-4 ${p.bg} px-8 py-2 rounded-full font-black`}>{p.name} 选手</div>
                                    <div className={`text-[12rem] font-black p-16 rounded-[5rem] border-[15px] bg-white ${p.color} transition-all ${gameState === 'ready' ? 'scale-110 border-yellow-400 shadow-2xl' : 'border-white opacity-80'}`}>
                                        {p.num}
                                    </div>
                                </div>
                            ))}
                        </div>
                        {gameState === 'ready' && <button onClick={startMatch} className="mt-16 bg-yellow-400 text-orange-600 px-20 py-8 rounded-3xl text-7xl font-black animate-bounce shadow-xl">上台准备！</button>}
                    </div>
                );
            }

            if (gameState === 'playing' || gameState === 'round_result') {
                return (
                    <div className="h-screen w-screen bg-[#FFFBEB] flex flex-col relative overflow-hidden text-slate-800">
                        {/* 侧边管理 */}
                        <div className="absolute left-4 top-1/2 -translate-y-1/2 z-50 flex flex-col items-center gap-4">
                            <button onClick={() => {playSound('quiet'); setBehaviorScores(s => ({...s, left: s.left-5}))}} className="bg-blue-500 text-white p-6 rounded-3xl border-4 border-white shadow-xl active:scale-90 font-black text-2xl">
                                🤐 {classNameLeft} 安静!
                            </button>
                            <div className="bg-blue-100 text-blue-600 px-4 py-2 rounded-xl font-black">行为: {behaviorScores.left}</div>
                        </div>
                        <div className="absolute right-4 top-1/2 -translate-y-1/2 z-50 flex flex-col items-center gap-4">
                            <button onClick={() => {playSound('quiet'); setBehaviorScores(s => ({...s, right: s.right-5}))}} className="bg-green-500 text-white p-6 rounded-3xl border-4 border-white shadow-xl active:scale-90 font-black text-2xl">
                                🤐 {classNameRight} 安静!
                            </button>
                            <div className="bg-green-100 text-green-600 px-4 py-2 rounded-xl font-black">行为: {behaviorScores.right}</div>
                        </div>

                        {/* 顶部 */}
                        <div className="h-28 bg-white/90 border-b-8 border-orange-200 flex items-center justify-between px-32 z-40">
                            <div className="text-center">
                                <div className="text-2xl text-blue-500 font-black">{classNameLeft} ({selectedLeft}号)</div>
                                <div className="text-6xl font-black text-blue-600 leading-none">{scores.left + behaviorScores.left}</div>
                            </div>
                            <div className={`text-7xl font-black px-12 py-3 rounded-full ${timeLeft <= 10 ? 'bg-red-100 text-red-500 animate-pulse' : 'bg-orange-100 text-orange-500'}`}>
                                {timeLeft}s
                            </div>
                            <div className="text-center">
                                <div className="text-2xl text-green-500 font-black">{classNameRight} ({selectedRight}号)</div>
                                <div className="text-6xl font-black text-green-600 leading-none">{scores.right + behaviorScores.right}</div>
                            </div>
                        </div>

                        {/* 题目 */}
                        <div className="absolute top-32 left-1/2 -translate-x-1/2 z-40 w-full flex justify-center px-10">
                            <div className="bg-white px-12 py-6 rounded-full border-8 border-orange-400 shadow-2xl animate-bounce">
                                <span className="text-7xl font-black text-slate-800 whitespace-nowrap">{currentQuestion?.prompt}</span>
                            </div>
                        </div>

                        <div className="flex-1 flex">
                            <div className={`flex-1 relative border-r-4 border-orange-100 ${shake.left ? 'animate-shake' : ''} ${locks.left && gameState === 'playing' ? 'opacity-30' : ''}`}>
                                {gameState === 'playing' && <FruitArea items={generateFruit(currentQuestion)} onSlice={c => handleSlice('left', c)} locked={locks.left} />}
                                {failed.left && <div className="absolute inset-0 flex items-center justify-center text-red-600/30 text-[15rem] font-black">X</div>}
                                {splashes.filter(s => s.side === 'left').map(s => <Splash key={s.id} x={s.x} y={s.y} color="#60a5fa" />)}
                            </div>
                            <div className={`flex-1 relative ${shake.right ? 'animate-shake' : ''} ${locks.right && gameState === 'playing' ? 'opacity-30' : ''}`}>
                                {gameState === 'playing' && <FruitArea items={generateFruit(currentQuestion)} onSlice={c => handleSlice('right', c)} locked={locks.right} />}
                                {failed.right && <div className="absolute inset-0 flex items-center justify-center text-red-600/30 text-[15rem] font-black">X</div>}
                                {splashes.filter(s => s.side === 'right').map(s => <Splash key={s.id} x={s.x} y={s.y} color="#4ade80" />)}
                            </div>
                        </div>

                        {gameState === 'round_result' && (
                            <div className="absolute inset-0 bg-black/70 backdrop-blur-md z-[100] flex flex-col items-center justify-center p-10">
                                <h3 className="text-5xl text-yellow-300 font-black mb-6 italic tracking-widest">本轮结束</h3>
                                <h2 className="text-[9rem] font-black text-white drop-shadow-2xl mb-12 text-center">
                                    {roundWinner === '没有人答对' ? <span className="text-red-400">没有人答对 😱</span> : `${roundWinner} 胜 !`}
                                </h2>
                                <button onClick={() => startRoundDrawing()} className="bg-white text-orange-600 px-16 py-6 rounded-full text-6xl font-black shadow-xl flex items-center gap-4">下一组抽签 🔄</button>
                            </div>
                        )}
                    </div>
                );
            }

            if (gameState === 'final_result') {
                const fL = scores.left + behaviorScores.left;
                const fR = scores.right + behaviorScores.right;
                return (
                    <div className="min-h-screen bg-orange-400 flex flex-col items-center justify-center text-white p-10">
                        <h1 className="text-[9rem] font-black drop-shadow-2xl mb-16 animate-bounce">🥇 终极赢家 🥇</h1>
                        <div className="flex gap-32 mb-16">
                            <div className={`text-center p-16 rounded-[4rem] bg-white text-slate-800 border-[20px] ${fL >= fR ? 'border-yellow-400 shadow-2xl' : 'border-slate-300 opacity-40'} min-w-[400px]`}>
                                <div className="text-6xl mb-6 font-black">{classNameLeft} 班</div>
                                <div className="text-[12rem] font-black">{fL}</div>
                            </div>
                            <div className={`text-center p-16 rounded-[4rem] bg-white text-slate-800 border-[20px] ${fR >= fL ? 'border-yellow-400 shadow-2xl' : 'border-slate-300 opacity-40'} min-w-[400px]`}>
                                <div className="text-6xl mb-6 font-black">{classNameRight} 班</div>
                                <div className="text-[12rem] font-black">{fR}</div>
                            </div>
                        </div>
                        <h2 className="text-6xl font-black mb-12 animate-pulse">🍹 恭喜 {fL >= fR ? classNameLeft : classNameRight} 班！老师请喝大杯橙汁！🍊</h2>
                        <button onClick={() => setGameState('setup')} className="bg-slate-800 text-white px-16 py-6 rounded-full text-5xl font-black">返回设置</button>
                    </div>
                );
            }
            return null;
        };

        // --- 辅助组件 ---
        const generateFruit = (q) => {
            const pool = [ {w: q.target, c: true, i: '🍉'}, ...q.distractors.map(d => ({w: d, c: false, i: '🍎'})) ];
            return pool.sort(() => Math.random() - 0.5).map((item, i) => ({
                ...item, id: i,
                x: 10 + (i % 2 === 0 ? 0 : 45) + Math.random() * 25,
                y: 45 + Math.floor(i / 2) * 20 + Math.random() * 5,
                bg: ['bg-pink-400', 'bg-yellow-400', 'bg-orange-400', 'bg-green-500'][i % 4],
                delay: Math.random() * 2
            }));
        };

        const FruitArea = ({ items, onSlice, locked }) => (
            <div className="absolute inset-0">
                {items.map(it => (
                    <button key={it.id} disabled={locked} onClick={() => onSlice(it.c)}
                        style={{ left: `${it.x}%`, top: `${it.y}%`, animationDelay: `${it.delay}s` }}
                        className={`absolute w-44 h-44 rounded-full ${it.bg} border-8 border-white shadow-2xl flex flex-col items-center justify-center fruit-anim transition-transform active:scale-150 z-10`}>
                        <span className="text-3xl leading-none">{it.i}</span>
                        <span className="text-[5.5rem] font-black text-white leading-none drop-shadow-lg">{it.w}</span>
                    </button>
                ))}
            </div>
        );

        const Splash = ({ x, y, color }) => (
            <div className="absolute w-24 h-24 rounded-full animate-splash pointer-events-none z-20"
                style={{ left: `${x}%`, top: `${y}%`, background: color, filter: 'blur(15px)' }} />
        );

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
